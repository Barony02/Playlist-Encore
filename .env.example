# Copie este arquivo para ".env" e preencha o que for usar.
PORT=3000

# YouTube: https://console.cloud.google.com -> ative "YouTube Data API v3" -> Credenciais -> Chave de API
YOUTUBE_API_KEY=

# Apple Music: conta Apple Developer -> Certificates, Identifiers & Profiles -> Keys -> Media Services (MusicKit)
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Caminho do arquivo .p8 baixado (ou, em vez disso, o conteudo da chave em APPLE_PRIVATE_KEY com \n no lugar das quebras de linha)
APPLE_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APPLE_PRIVATE_KEY=

# Spotify: https://developer.spotify.com/dashboard -> Create app
# Adicione exatamente este Redirect URI no painel do app (o Spotify exige 127.0.0.1, nao "localhost"):
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
